        </main>

        .board-area {
    flex: 1;
    padding: 1.25rem;
    background: #edf2f7;
    min-height: calc(100vh - 90px);
}

.board-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.2rem 0.5rem;
}

.board-header h4 {
    margin: 0;
    color: #1f2d3d;
    font-weight: 700;
}

.board-columns {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    overflow-x: auto;
    padding-bottom: 0.5rem;
}

.board-column {
    background: #dfe8f3;
    border: 1px solid #c8d5e2;
    border-radius: 12px;
    min-width: 260px;
    width: 260px;
    padding: 0.8rem;
}

.column-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    color: #1f2d3d;
    margin-bottom: 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #c7d4e1;
}

.count {
    background: #b8c9dd;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
}

.task-card {
    background: #fff;
    border-radius: 10px;
    padding: 0.8rem;
    margin-bottom: 0.8rem;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    border-left: 4px solid #a9b9d0;
}

.task-card h6 {
    font-size: 0.98rem;
    margin: 0.5rem 0 0.35rem;
    color: #1d2b39;
}

.task-card p {
    font-size: 0.8rem;
    margin: 0;
    color: #586677;
}

.priority-high {
    border-left-color: #e74c3c;
}

.priority-medium {
    border-left-color: #f4b400;
}

.priority-low {
    border-left-color: #2ecc71;
}

.priority-red {
    border-left-color: #d63031;
}

.tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
}

.tag-red {
    background: #fdecea;
    color: #c0392b;
}

.tag-yellow {
    background: #fff5d9;
    color: #b7791f;
}

.tag-green {
    background: #eafaf1;
    color: #1f8f5f;
}
